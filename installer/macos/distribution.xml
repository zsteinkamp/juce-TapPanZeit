<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>TapPanZeit __VERSION__</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <domains enable_localSystem="true"/>

  <choices-outline>
    <line choice="vst3"/>
    <line choice="au"/>
  </choices-outline>

  <choice id="vst3" title="VST3 plug-in" description="Installs TapPanZeit.vst3 into /Library/Audio/Plug-Ins/VST3 (Ableton Live, Bitwig, Reaper, Cubase, …).">
    <pkg-ref id="us.steinkamp.TapPanZeit.vst3"/>
  </choice>
  <choice id="au" title="Audio Unit plug-in" description="Installs TapPanZeit.component into /Library/Audio/Plug-Ins/Components (Logic Pro, GarageBand, Ableton Live, …).">
    <pkg-ref id="us.steinkamp.TapPanZeit.au"/>
  </choice>

  <pkg-ref id="us.steinkamp.TapPanZeit.vst3" version="__VERSION__">us.steinkamp.TapPanZeit.vst3.pkg</pkg-ref>
  <pkg-ref id="us.steinkamp.TapPanZeit.au" version="__VERSION__">us.steinkamp.TapPanZeit.au.pkg</pkg-ref>
</installer-gui-script>
